<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>FileMakerDataApi</PackageId>
    <Version>1.0.0</Version>
    <Description>C# wrapper for the Claris FileMaker Data API. Ported from rcconsulting/myFMApiLibrary-for-PHP.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FileMakerDataApi.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the test project from the library build -->
    <Compile Remove="FileMakerDataApi.Tests/**" />
  </ItemGroup>

</Project>
